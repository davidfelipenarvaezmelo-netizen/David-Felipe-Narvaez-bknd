# Servidor
PORT=5000
NODE_ENV=development

# Base de datos (MongoDB Atlas en producción)
# Formato: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/rutaseguras?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/rutaseguras?retryWrites=true&w=majority

# Frontend autorizado por CORS (en producción: URL de Vercel)
# Admite varios orígenes separados por coma, por ejemplo:
# FRONTEND_URL=https://rutas-seguras-xi.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Variable heredada (opcional). Se mantiene como respaldo si FRONTEND_URL no existe.
# CLIENT_URL=http://localhost:5173

# Autenticación (JWT). Genera un secreto largo y aleatorio en producción.
# Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Usuario administrador por defecto (se crea al iniciar si no existe)
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@rutaseguras.local
ADMIN_PASSWORD=admin2026*
# Ponlo en "true" una sola vez para aplicar un cambio de ADMIN_PASSWORD a un admin ya existente
ADMIN_SYNC_PASSWORD=false
