# Servidor
PORT=5000
NODE_ENV=development

# Base de datos (MongoDB Atlas en producción)
# Formato: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/rutaseguras?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/rutaseguras?retryWrites=true&w=majority

# Frontend autorizado por CORS (en producción: URL de Vercel)
# Admite varios orígenes separados por coma, por ejemplo:
# FRONTEND_URL=https://rutas-seguras-xi.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Variable heredada (opcional). Se mantiene como respaldo si FRONTEND_URL no existe.
# CLIENT_URL=http://localhost:5173
